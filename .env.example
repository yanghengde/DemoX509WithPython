# 不配置模型也可启动，聊天将返回框架状态说明。
APP_HOST=127.0.0.1
APP_PORT=8031
APP_USERNAME=local-user
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# stdio MCP 默认可用；HTTP MCP 开启时必须填写令牌。
ENABLE_MCP_HTTP=False
MCP_API_KEY=

# 本地 Opcenter：使用已在 Opcenter 中授权的证书；无需模型 Key。
OPCENTER_BASE_URL=http://opcenter2607/sit-svc/Siemens/Application/AppU4DM/odata
OPCENTER_X509_SOURCE=store
OPCENTER_X509_STORE_LOCATION=LocalMachine
OPCENTER_X509_THUMBPRINT=
# PFX 方式：将 SOURCE 改为 pfx，并填写以下配置。
# OPCENTER_X509_PFX_PATH=C:/certs/integration.pfx
# OPCENTER_X509_PFX_PASSWORD=
# OPCENTER_VERIFY_TLS=True
